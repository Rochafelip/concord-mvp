# Template for local/dev environment values used by docker-compose.yml.
# Copy this file to `.env` (gitignored) in this directory and fill in real
# values before running `docker compose up`.

POSTGRES_DB=concordmvp
POSTGRES_USER=concordmvp
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# LiveKit (voice channels — docs/ARCHITECTURE.md §19, docs/DECISIONS.md D16). LIVEKIT_API_KEY/
# SECRET must match between the backend (mints tokens) and the livekit service (validates them,
# via LIVEKIT_KEYS in docker-compose.yml) — any key/secret pair works, they aren't provisioned
# externally. LIVEKIT_PUBLIC_URL is the browser-facing address the frontend connects to, proxied
# by nginx at /livekit/ (see infrastructure/nginx/nginx.conf) — set the host to the VM's public
# IP or domain.
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-to-a-long-random-string
LIVEKIT_PUBLIC_URL=wss://change-me-vm-public-ip/livekit

# Production deployment only (infrastructure/DEPLOY.md) — real domain used to request a Let's
# Encrypt certificate and to render infrastructure/nginx/nginx.prod.conf.template. Leave as-is
# (or unset) for the self-signed local-review workflow (infrastructure/VM_REVIEW.md), which
# doesn't use it. When set for real, also update LIVEKIT_PUBLIC_URL above to use the same domain
# instead of a bare IP, and infrastructure/livekit/livekit.yaml's turn.domain to match.
DOMAIN=change-me.example.com

# Public URL used in email verification links for the home deployment.
# Include the external HTTPS port when 443 is not forwarded directly.
APP_BASE_URL=https://${DUCKDNS_SUBDOMAIN}.duckdns.org:45678

# Email address Let's Encrypt associates with the certificate (expiry reminders, account
# recovery). Required by certbot in infrastructure/DEPLOY.md's issuance/renewal commands.
ACME_EMAIL=change-me@example.com

# Transactional email (account activation, password reset). The application authenticates as a
# real mailbox over SMTP -- for Gmail, MAIL_PASSWORD must be a 16-character App Password, not the
# account password (App Passwords require 2-Step Verification on the account).
#
# MAIL_FROM must stay on the same domain the SMTP service authenticates as, or SPF/DKIM stop
# aligning with the From header and DMARC fails -- which is worse for deliverability than the
# mismatch it was meant to fix. infrastructure/EMAIL.md explains this and lists the DNS records
# to publish if this deployment ever moves to a registered domain.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me@gmail.com
MAIL_PASSWORD=change-me-app-password
MAIL_FROM=change-me@gmail.com

# Display name recipients see. Without it the message shows up as a bare address, which reads as
# bulk mail to both people and filters.
MAIL_FROM_NAME=Concord

# Optional. Leave empty to have replies go to MAIL_FROM.
MAIL_REPLY_TO=

# Set to false to log emails instead of sending them (useful for local development).
MAIL_ENABLED=true
