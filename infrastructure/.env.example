# Template for local/dev environment values used by docker-compose.yml.
# Copy this file to `.env` (gitignored) in this directory and fill in real
# values before running `docker compose up`.

POSTGRES_DB=concordmvp
POSTGRES_USER=concordmvp
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# LiveKit (voice channels — docs/ARCHITECTURE.md §19, docs/DECISIONS.md D16). LIVEKIT_API_KEY/
# SECRET must match between the backend (mints tokens) and the livekit service (validates them,
# via LIVEKIT_KEYS in docker-compose.yml) — any key/secret pair works, they aren't provisioned
# externally. LIVEKIT_PUBLIC_URL is the browser-facing address the frontend connects to, proxied
# by nginx at /livekit/ (see infrastructure/nginx/nginx.conf) — set the host to the VM's public
# IP or domain.
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-to-a-long-random-string
LIVEKIT_PUBLIC_URL=wss://change-me-vm-public-ip/livekit
